<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="002-criar-curso" author="atividade">
        <createTable tableName="curso">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_curso" nullable="false"/>
            </column>
            <column name="titulo" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="carga_horaria" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="nivel" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="instrutor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="curso" baseColumnNames="instrutor_id"
                                 referencedTableName="instrutor" referencedColumnNames="id"
                                 constraintName="fk_curso_instrutor" onDelete="RESTRICT"/>
        <rollback>
            <dropTable tableName="curso" cascadeConstraints="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
