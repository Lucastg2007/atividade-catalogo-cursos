<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="001-criar-instrutor" author="atividade">
        <createTable tableName="instrutor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_instrutor" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="instrutor" columnNames="email" constraintName="uk_instrutor_email"/>
        <rollback>
            <dropTable tableName="instrutor" cascadeConstraints="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
